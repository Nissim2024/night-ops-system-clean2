# ============================================================
# NightOps — Production Environment Template
# העתק ל: /opt/nightops/blue/.env.blue  ו- /opt/nightops/green/.env.green
# ============================================================

SLOT=blue
APP_VERSION=v2.2.0

# Database (PostgreSQL נטיב על השרת)
DATABASE_URL=postgresql://nightops_user:REPLACE_PASSWORD@localhost:5432/nightops_prod

# JWT — מחרוזת רנדומלית ארוכה (מינימום 32 תווים)
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_MIN_32_CHARS

# CORS — כתובת הגישה של המשתמשים (לדוגמה: http://192.168.1.50 או https://nightops.company.local)
CORS_ORIGINS=REPLACE_WITH_SERVER_URL

# Push Notifications — השאר ריק לביטול
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# LDAP — השאר false אם לא נדרש
LDAP_ENABLED=false
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
