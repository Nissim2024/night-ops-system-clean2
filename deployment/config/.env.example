# ============================================================
#  NightOps Production Environment — FILL ALL VALUES
#  Copy to .env.blue and .env.green (change SLOT per file)
# ============================================================

# Slot identifier — "blue" or "green"
SLOT=blue

# App version tag (e.g. v2.2.0) — set by deploy script automatically
APP_VERSION=v2.2.0

# ── Database (external PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://nightops_user:CHANGE_ME@DB_HOST:5432/nightops_prod

# ── Auth ─────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# ── Web Push (optional) ──────────────────────────────────────
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_EMAIL=mailto:admin@yourcompany.com

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated frontend URLs allowed to call the backend
CORS_ORIGINS=http://YOUR_SERVER_IP,https://YOUR_DOMAIN

# ── Oracle BI (optional) ─────────────────────────────────────
ORACLE_ENABLED=false
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=

# ── Redis (external) ─────────────────────────────────────────
REDIS_URL=redis://REDIS_HOST:6379
