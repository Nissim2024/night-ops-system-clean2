# DeployCenter — הגדרות סביבה
# העתק קובץ זה ל-.env ומלא את הערכים

# ← סיסמה לבסיס הנתונים (בחר סיסמה חזקה)
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ← מחרוזת אבטחה (הרץ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" )
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# ← כתובת האתר (URL) — כפי שמוקלד בדפדפן
CORS_ORIGINS=http://YOUR_SERVER_IP_OR_DOMAIN
