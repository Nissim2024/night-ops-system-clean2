###############################################################################
# DeployCenter 2.8.0 — Production Environment Template
#
# העתק קובץ זה ל-.env ומלא את הערכים
#   cp .env.template .env
#   nano .env
###############################################################################

# ── Database ─────────────────────────────────────────────────────────────────
# סיסמה חזקה לבסיס הנתונים (לפחות 16 תווים, אותיות+מספרים+סימנים)
DB_PASSWORD=CHANGE_ME_StrongPassword123!

# ── JWT ──────────────────────────────────────────────────────────────────────
# מחרוזת אקראית ארוכה לחתימת טוקנים — שנה לערך ייחודי!
# ניתן להשתמש ב: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_replace-with-a-long-random-secret-here

# ── CORS ─────────────────────────────────────────────────────────────────────
# כתובות מאושרות לגישה ל-API (כתובת שרת ה-RHEL)
# לריבוי כתובות: http://192.168.1.100,https://deploycenter.company.com
CORS_ORIGINS=http://YOUR_SERVER_IP

# ── Oracle Client (Thick Mode — נדרש ל-Oracle 11g) ───────────────────────────
# נתיב ל-Oracle Instant Client lib בתוך הcontainer (כפי שמוגדר ב-docker-compose volumes)
ORACLE_LIB_DIR=/oracle/lib

# נתיב ל-Oracle Home בתוך הcontainer (נדרש למניעת ORA-01804 — חדש ב-2.7.2)
# source directory: /DeployCenter/oracle/product/19.0.0/client_1
ORACLE_HOME=/oracle/client

# ── QC / SMB ─────────────────────────────────────────────────────────────────
# נתיב לקובץ cr_list.xls בתוך הcontainer (לאחר mount של SMB share)
# ריק = Oracle/QC מנוטרל
QC_RELEASES_FILE=/mnt/qc-releases/cr_list.xls

# ── Data Migration ───────────────────────────────────────────────────────────
# נתיב לקובץ deploycenter-data-export.json בתוך הcontainer (/data = /opt/deploycenter על host)
# ריק = לא מייבא נתונים בHotstart
SEED_DATA_FILE=/data/deploycenter-data-export.json

# ── Admin Seed ───────────────────────────────────────────────────────────────
# נוצר רק אם בDB אין משתמשים כלל ו-SEED_DATA_FILE ריק
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Admin

###############################################################################
# ערכים אלה מנוהלים דרך AdminPanel (לא דרך .env):
#   ORACLE_ENABLED, ORACLE_USER, ORACLE_PASSWORD, ORACLE_CONNECT_STRING
#   EMAIL_HOST, EMAIL_USER, EMAIL_PASS, EMAIL_FROM
#   LDAP_URL, LDAP_BASE, LDAP_BIND_DN, LDAP_BIND_PASSWORD
###############################################################################
