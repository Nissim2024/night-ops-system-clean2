# העתק קובץ זה ל-.env.prod ומלא את הערכים האמיתיים

# --- Database ---
DB_USER=nightops_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=nightops_prod

# --- Auth ---
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

# --- Push Notifications (VAPID) ---
# לייצר עם: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourorg.com

# --- LDAP / Active Directory (אופציונלי) ---
LDAP_ENABLED=false
LDAP_URL=ldap://dc.yourorg.local
LDAP_BASE_DN=DC=yourorg,DC=local
LDAP_BIND_DN=CN=svc_nightops,OU=ServiceAccounts,DC=yourorg,DC=local
LDAP_BIND_PASSWORD=
