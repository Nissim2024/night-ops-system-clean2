# Copy this file to .env and fill in real values. NEVER commit .env to git.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nightops"

# Must be a long random string — generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_use_openssl_rand_hex_32"

PORT=3000

# Oracle DB (optional — for QC user sync)
ORACLE_ENABLED=false
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
