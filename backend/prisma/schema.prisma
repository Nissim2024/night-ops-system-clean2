generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  RELEASE_MANAGER
  CR_MANAGER
  TEAM_LEAD
  EMPLOYEE
  VIEWER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  WAITING
  DONE
  FAILED
  ROLLED_BACK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
}

enum VersionStatus {
  DRAFT
  CR_REVIEW
  COLLECTING
  REFINING
  REVIEW
  APPROVED
  REHEARSAL
  ACTIVE
  MORNING_AFTER
  COMPLETED
  ROLLED_BACK
}

enum Environment {
  HOT
  HOTNET
  BOTH
}

enum ExecutionStatus {
  NOT_TESTED
  PASSED
  FAILED
  PARTIAL
}

enum SubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

// ── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(EMPLOYEE)
  active    Boolean  @default(true)
  // QC's own USERS.USER_NAME (the raw login string that shows up in BUG-table
  // free-text columns like BG_RESPONSIBLE/BG_DETECTED_BY, e.g. "guyp") — lets
  // TARGET-defect person fields resolve to a real display name instead of
  // showing the raw QC login. Nullable: only populated when synced via Oracle
  // (syncQcUsers) — the HARDCODED_QC_USERS fallback has no login data.
  qcLogin   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMemberships        TeamMember[]
  createdVersions        Version[]         @relation("createdByUser")
  approvedVersions       Version[]         @relation("approvedByUser")
  scopeApprovedVersions  Version[]         @relation("scopeApprovedByUser")
  createdTasks           Task[]            @relation("taskCreator")
  assignedTasks          Task[]            @relation("taskAssignee")
  auditLogs              AuditLog[]
  submissions            TeamSubmission[]
  versionTemplates       VersionTemplate[]
  testerProfile          TesterProfile?
  leaveRequests          LeaveRequest[]
  qaAssignments          QaAssignment[]
  qaSecondaryAssignments QaAssignment[]    @relation("qaSecondaryAssignments")
  qaCycleTasks           QaCycleTask[]
  createdReleaseRisks    ReleaseRisk[]
  createdVersionNotices  VersionNotice[]
}

model Team {
  id           String   @id @default(uuid())
  name         String
  description  String?
  apps         String[] @default([])
  active       Boolean  @default(true)
  requiresPlan Boolean  @default(true)
  createdAt    DateTime @default(now())

  members              TeamMember[]
  assignedTasks        Task[]                @relation("taskAssignedTeam")
  phases               Phase[]
  submissions          TeamSubmission[]
  crPlans              CrPlan[]
  versionCrAssignments VersionCrAssignment[]
}

model TeamMember {
  userId String
  teamId String
  isLead Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@id([userId, teamId])
}

model Version {
  id                    String        @id @default(uuid())
  name                  String
  description           String?
  status                VersionStatus @default(DRAFT)
  collectionDeadline    DateTime?
  reviewMeetingTime     DateTime?
  workPlanMeetingTime   DateTime?
  plannedStart          DateTime?
  plannedEnd            DateTime?
  actualStart           DateTime?
  completedAt           DateTime?
  importedFileName      String?
  createdBy             String
  approvedBy            String?
  approvedAt            DateTime?
  scopeApprovedBy       String?
  scopeApprovedAt       DateTime?
  lastRehearsalSnapshot Json?
  lastRehearsalAt       DateTime?
  lastNightSnapshot     Json?
  lastNightAt           DateTime?
  isArchived            Boolean       @default(false)
  archivedAt            DateTime?
  integrationStart      DateTime?
  integrationEnd        DateTime?
  qaStart               DateTime?
  qaEnd                 DateTime?
  plannedRehearsalStart DateTime?
  plannedRehearsalEnd   DateTime?
  submissionDeadline    DateTime?
  approvalDeadline      DateTime?
  wizardState           Json?
  // When true (set on creation for every version created after 2026-07-24 —
  // see versions.service.ts's create()): once a QaWorkPlan exists,
  // integrationStart/End, qaStart/End and plannedRehearsalStart/End are
  // synced from the QA work plan on every plan change (qa-workplan.service.ts)
  // and shouldn't be edited independently. plannedStart (go-live) is
  // different: it's auto-filled from the plan's GO_LIVE cycle only the first
  // time (while still null) — once set, it's a fixed external commitment a
  // release manager sets deliberately (still editable via the normal version
  // PATCH) and the QA cascade never overwrites it again; later plan changes
  // are instead checked against it (GO_LIVE_OVERFLOW). Existing versions
  // default to false (unlocked, legacy independent-date behavior) and are
  // never migrated — per explicit product decision, only new versions get
  // the new behavior.
  datesLockedToWorkPlan Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  qcReleaseId String?
  qcRelease   QcRelease? @relation(fields: [qcReleaseId], references: [id])

  creator              User                  @relation("createdByUser", fields: [createdBy], references: [id])
  approver             User?                 @relation("approvedByUser", fields: [approvedBy], references: [id])
  scopeApprover        User?                 @relation("scopeApprovedByUser", fields: [scopeApprovedBy], references: [id])
  phases               Phase[]
  submissions          TeamSubmission[]
  nightSummary         NightSummary?
  rehearsalSummary     RehearsalSummary?
  rehearsalArchives    RehearsalRunArchive[]
  taskProposals        TaskProposal[]
  crPlans              CrPlan[]
  qaAssignments        QaAssignment[]
  versionCrAssignments VersionCrAssignment[]
  qaWorkPlan           QaWorkPlan?
  releaseRisks         ReleaseRisk[]
  releaseInsights      ReleaseInsight[]
  releaseHealth        ReleaseHealth?
  releaseForecast      ReleaseForecast?
  goNoGoDecision       GoNoGoDecision?
  notices              VersionNotice[]
  incidents            Incident[]
}

model Phase {
  id           String      @id @default(uuid())
  versionId    String
  teamId       String?
  name         String
  orderIndex   Int
  environment  Environment @default(BOTH)
  isGoNoGo     Boolean     @default(false)
  plannedStart DateTime?
  plannedEnd   DateTime?
  createdAt    DateTime    @default(now())

  version   Version    @relation(fields: [versionId], references: [id])
  team      Team?      @relation(fields: [teamId], references: [id])
  subPhases SubPhase[]
}

model SubPhase {
  id         String   @id @default(uuid())
  phaseId    String
  name       String
  orderIndex Int
  createdAt  DateTime @default(now())

  phase Phase  @relation(fields: [phaseId], references: [id])
  tasks Task[]
}

model Task {
  id                    String          @id @default(uuid())
  title                 String
  description           String?
  crNumber              String?
  application           String?
  status                TaskStatus      @default(OPEN)
  priority              Priority        @default(MEDIUM)
  assignedTeamId        String?
  assignedUserId        String?
  assignedUserName      String?
  blockedReason         String?
  blockedSeverity       BlockSeverity?
  completedAt           DateTime?
  createdBy             String
  createdByTeamLead     String?
  environment           Environment     @default(BOTH)
  executionStatus       ExecutionStatus @default(NOT_TESTED)
  followupNotes         String?
  isCritical            Boolean         @default(false)
  isCriticalForGo       Boolean         @default(false)
  lastEditedAt          DateTime?
  lastEditedBy          String?
  morningFollowup       Boolean         @default(false)
  notes                 String?
  dependencyNote        String?
  duration              String?
  orderIndex            Int             @default(0)
  startedAt             DateTime?
  actualStart           DateTime?
  actualFinish          DateTime?
  delayReason           String?
  subPhaseId            String?
  testerInNight         String?
  testerInVersion       String?
  versionId             String?
  plannedStart          DateTime?
  plannedEnd            DateTime?
  rehearsalPlannedStart DateTime?
  rehearsalPlannedEnd   DateTime?
  dueDate               DateTime?
  goNoGoWaived          Boolean         @default(false)
  waivedBy              String?
  waivedAt              DateTime?
  failedReason          String?
  failureReasonId       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  assignedTeam Team?            @relation("taskAssignedTeam", fields: [assignedTeamId], references: [id])
  assignedUser User?            @relation("taskAssignee", fields: [assignedUserId], references: [id])
  creator      User             @relation("taskCreator", fields: [createdBy], references: [id])
  subPhase     SubPhase?        @relation(fields: [subPhaseId], references: [id])
  auditLogs    AuditLog[]
  dependencies TaskDependency[] @relation("taskDeps")
  dependents   TaskDependency[] @relation("taskDependents")
}

model TaskDependency {
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task      Task @relation("taskDeps", fields: [taskId], references: [id])
  dependsOn Task @relation("taskDependents", fields: [dependsOnTaskId], references: [id])

  @@id([taskId, dependsOnTaskId])
}

model TeamSubmission {
  id                     String           @id @default(uuid())
  versionId              String
  teamId                 String
  status                 SubmissionStatus @default(NOT_STARTED)
  submittedBy            String?
  submittedAt            DateTime?
  taskCount              Int              @default(0)
  notRequiredForApproval Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  version   Version @relation(fields: [versionId], references: [id])
  team      Team    @relation(fields: [teamId], references: [id])
  submitter User?   @relation(fields: [submittedBy], references: [id])

  @@unique([versionId, teamId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  taskId     String?
  action     String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User  @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [taskId], references: [id])
}

model RolePermissions {
  role        Role     @id
  permissions Json // string[]
  updatedAt   DateTime @updatedAt
}

model RehearsalSummary {
  id           String    @id @default(uuid())
  versionId    String    @unique
  headline     String?
  morningNotes String?
  crData       Json?
  sentAt       DateTime?
  sentBy       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  version Version @relation(fields: [versionId], references: [id])
}

// A frozen copy of one completed rehearsal run's task snapshot + summary,
// captured right before a version re-enters REHEARSAL for another run.
// Version.lastRehearsalSnapshot and RehearsalSummary are both single/@unique
// per version — a second rehearsal would silently overwrite the first run's
// report with no way back to it without this.
model RehearsalRunArchive {
  id            String    @id @default(uuid())
  versionId     String
  runNumber     Int // 1, 2, 3... sequential per version
  ranAt         DateTime? // the lastRehearsalAt being archived
  tasksSnapshot Json? // copy of lastRehearsalSnapshot at archive time
  headline      String?
  morningNotes  String?
  crData        Json?
  sentAt        DateTime?
  sentBy        String?
  archivedAt    DateTime  @default(now())

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, runNumber])
}

model EmailRecipient {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model QcRelease {
  id               String    @id @default(uuid())
  relId            Int       @unique
  relParentId      Int?
  relName          String
  relStartDate     DateTime?
  relEndDate       DateTime?
  relTeam          String?
  goLiveCycleId    Int?
  goLiveDate       DateTime?
  rehearsalCycleId Int?
  rehearsalDate    DateTime?
  filterDate       DateTime? // REL_USER_03 — filter: show in dropdown only if > today
  active           Boolean   @default(true)
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  versions Version[]
}

model VersionTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  structure   Json
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id])
}

enum ProposalStatus {
  DRAFT
  READY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

model TaskProposal {
  id                String         @id @default(uuid())
  versionId         String
  teamId            String
  submittedBy       String
  title             String
  app               String?
  estimatedMins     Int?
  crNumber          String?
  notes             String?
  assignedUserName  String? // whom the team lead designates as responsible
  crLabel           String? // display label from QC for the linked CR
  phase             Int // 1=בוקר גרסה, 2=HOTNET, 3=HOT, 4=בוקר לאחר
  system            String? // CRM / WIZ / ETL / EAI / MEDIATION …
  actionType        String? // הטמעת קוד / פרמטרים / הרשאות / תהליך / הסבה / פעולה ידנית
  subPhaseId        String? // exact sub-phase chosen (optional, used at conversion)
  responsibleTeamId String? // צוות אחראי לביצוע (may differ from submitting teamId)
  status            ProposalStatus @default(DRAFT)
  usedInTaskId      String? // set when manager picks this proposal
  reviewStatus      ReviewStatus   @default(PENDING)
  reviewNote        String? // manager comment when rejecting / returning
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  version Version @relation(fields: [versionId], references: [id])
}

enum CrPlanSubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

model CrPlan {
  id                  String                 @id @default(uuid())
  versionId           String
  teamId              String
  crNumber            String
  crLabel             String?
  crManager           String? // מנהל CR מהקובץ
  crDescription       String? // פרטים מהקובץ
  crType              String? // תיקון תקלה / פיתוח / תשתית
  riskLevel           String? // LOW / MEDIUM / HIGH
  systems             String[]               @default([])
  planApproved        Boolean                @default(false)
  planApprovedAt      DateTime?
  workPlan            String?
  scripts             String?
  runTimes            String?
  rollbackPlan        String?
  gradualRollout      Boolean                @default(false) // false = עלייה בליל הגרסה (רגילה), true = עלייה מדורגת
  gradualDetails      String? // שלבי העלייה (טקסט חופשי) — רלוונטי רק כאשר gradualRollout=true
  activationDate      DateTime? // תאריך הפעלה — רלוונטי רק כאשר gradualRollout=true
  nightTestingNotes   String?
  morningMonitoring   String?
  notNeededForPlan    Boolean                @default(false)
  removedByTeam       Boolean                @default(false) // team explicitly deleted this CR — sync must never resurrect it
  // ── טופס CR מובנה (exception-first) — אפיון 2026-07-17 ──
  gateAnswered        Boolean                @default(false) // האם ראש הצוות ענה על שאלת השער (Section 1)
  changeTypes         String[]               @default([]) // מה משתנה — קוד/פרמטר/הרשאה/Setup/ממשק/Job/סקריפט/הסבת נתונים/קובץ
  prerequisites       String[]               @default([]) // תנאים מקדימים
  prerequisitesNote   String? // הערות חופשיות נוספות לתנאים מקדימים
  nightTestNeeded     Boolean                @default(false) // בדיקות חריגות בליל הגרסה (הפירוט ב-nightTestingNotes)
  nextDayTestNeeded   Boolean                @default(false) // בדיקות חריגות ביום שאחרי
  nextDayTestNotes    String?
  rollbackType        String? // כיבוי פרמטר/הסרת הרשאה/עצירת Job/החזרת קובץ/חזרה מגיבוי/לא נדרש/אחר
  // ── תוכניות הטמעה — מחזור הגשה/סקירה/אישור ──
  submissionStatus    CrPlanSubmissionStatus @default(DRAFT)
  submittedAt         DateTime?
  submittedByName     String?
  returnReason        String?
  returnedAt          DateTime?
  approvedByName      String?
  reviewNote          String?
  // ── אישור מנהל CR (שלב לפני סקירה) ──
  crManagerApproved   Boolean                @default(false)
  crManagerApprovedAt DateTime?
  crManagerApprovedBy String?
  crManagerNote       String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  version          Version                 @relation(fields: [versionId], references: [id])
  team             Team                    @relation(fields: [teamId], references: [id])
  crDeps           CrDependency[]
  actions          CrPlanAction[]
  monitoringPoints CrPlanMonitoringPoint[]

  @@unique([versionId, teamId, crNumber])
}

model CrDependency {
  id          String  @id @default(uuid())
  crPlanId    String
  dependsOnCr String
  note        String? // הסבר התלות (למה ה-CR הזה תלוי ב-CR האחר)

  crPlan CrPlan @relation(fields: [crPlanId], references: [id], onDelete: Cascade)
}

// פעולה חריגה בודדת בתוך תוכנית CR (Section 2 בטופס)
// "מתי" מבוטא כ-phase/subPhaseId אמיתיים מתוכנית המסגרת של הגרסה (לא enum מופשט) —
// כדי לאפשר גזירת TaskProposal אוטומטית ומדוייקת (ר' CrPlansService.syncDerivedProposals).
model CrPlanAction {
  id                String   @id @default(uuid())
  crPlanId          String
  actionType        String
  description       String
  phase             Int      @default(2) // 1=בוקר לפני גרסה, 2=HOTNET, 3=HOT, 4=בוקר לאחר גרסה
  subPhaseId        String? // תת-שלב מדוייק (אופציונלי) בתוך ה-phase שנבחר
  system            String? // מערכת/אפליקציה עליה מתבצעת הפעולה
  estimatedMins     Int? // משך זמן פוטנציאלי — מוזן ישירות ל-TaskProposal הנגזר
  dependsOnTaskId   String? // תלות במשימה קיימת אמיתית מתוכנית המסגרת (Task.id) — תמיד "אחרי"
  dependencyNote    String? // הערה חופשית — משמש כאשר אין משימה תואמת בתוכנית
  ownerName         String?
  derivedProposalId String? // TaskProposal שנוצר/מסונכרן אוטומטית מפעולה זו
  sourceDefectId    String? // TargetCrDefect.id — כאשר פעולה זו נוצרה מסימון "דורשת הטמעה מיוחדת" על תקלת TARGET (null לפעולה שנוספה ידנית)
  orderIndex        Int      @default(0)
  createdAt         DateTime @default(now())

  crPlan CrPlan @relation(fields: [crPlanId], references: [id], onDelete: Cascade)
}

// נקודת בקרה/ניטור בודדת (Section 5 בטופס)
model CrPlanMonitoringPoint {
  id                String   @id @default(uuid())
  crPlanId          String
  type              String // Interface / Table / Job / Report / Queue / File / Other
  name              String
  note              String?
  phase             Int      @default(4) // כל שלב אפשרי — ברירת מחדל: בוקר לאחר גרסה
  assignedTeamId    String? // צוות אחראי לביצוע הבקרה
  assignedUserName  String? // עובד אחראי — קיומו מפעיל גזירת TaskProposal אוטומטית
  derivedProposalId String? // TaskProposal שנוצר/מסונכרן אוטומטית מנקודת בקרה זו
  orderIndex        Int      @default(0)
  createdAt         DateTime @default(now())

  crPlan CrPlan @relation(fields: [crPlanId], references: [id], onDelete: Cascade)
}

// ── TARGET CR — סקירה שונה לגמרי מ-CR רגיל ──────────────────────────────────
// CR מסוג "מעטפת" לתקלות QC (זוהה לפי crType/crLabel המכילים "TARGET") — ראש
// הצוות לא ממלא טופס השפעות/פעולות רגיל, אלא מאשר רשימת תקלות שהגיעה מ-Oracle
// ומסמן תקלות בודדות כדורשות הטמעה מיוחדת / חשובות להנהלה. תקלות שקיבלו דגל
// "דורשת הטמעה מיוחדת" גוזרות CrPlanAction/CrPlanMonitoringPoint אמיתיים על אותו
// CrPlan, ומשם ממשיכות באותו נתיב סנכרון ל-TaskProposal כמו כל פעולה רגילה.
model TargetCrReview {
  id             String    @id @default(uuid())
  versionId      String
  crNumber       String
  teamId         String
  gateChecklist1 Boolean   @default(false) // בדקתי את רשימת התקלות
  gateChecklist2 Boolean   @default(false) // לא חסרה תקלה שאמורה להיכלל
  gateChecklist3 Boolean   @default(false) // לא מופיעות תקלות שאינן מוכרות לי
  approved       Boolean   @default(false)
  approvedByName String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  defects TargetCrDefect[]

  @@unique([versionId, crNumber, teamId])
}

model TargetCrDefect {
  id                            String   @id @default(uuid())
  reviewId                      String
  defectId                      String // מזהה תקלה מ-Oracle (BG_BUG_ID)
  description                   String?
  requiresSpecialImplementation Boolean  @default(false)
  importantToManagement         Boolean  @default(false)
  derivedActionId               String? // CrPlanAction.id שנוצר מתקלה זו — אותה פעולה עצמה נערכת בסעיף 2 של תוכנית ה-CR (Section 2 — פעולות מיוחדות), לא כאן
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  review TargetCrReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, defectId])
}

model NightSummary {
  id                 String    @id @default(uuid())
  versionId          String    @unique
  headline           String?
  morningNotes       String?
  crData             Json?
  recipientsSnapshot Json?
  sentAt             DateTime?
  sentBy             String?
  forceApprovedBy    String?
  forceApprovedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  version Version @relation(fields: [versionId], references: [id])
}

model FailureReason {
  id               String   @id @default(uuid())
  reason           String   @unique
  requiresRollback Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemParam {
  key       String   @id
  value     String
  label     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model VersionCrAssignment {
  id                    String    @id @default(uuid())
  versionId             String
  crNumber              String
  crLabel               String?
  teamId                String
  crManager             String?
  crDescription         String?
  application           String?
  project               String?
  qaEffort              Float? // QA effort in DAYS (from CR_LIST QA+QA_BI cols ÷ 8)
  qaEffortOverride      Float? // manual override — not overwritten on re-sync
  requiredSkillMinLevel Int? // minimum skill level to test this CR (default 1)
  isStandAlone          Boolean   @default(false)
  estimateDays          Float? // from "סך כל הערכות" column in CR_LIST (CR total, all teams)
  teamEstimateDays      Float? // this team's individual estimate days from their column in CR_LIST
  hasActual             Boolean? // true when "Actuals" column has a V mark
  actualEffortDays      Float? // numeric value of the "Actuals" column itself (0 for a checkbox-style V/X cell, a real number when the source file has one) — used for the plan-vs-actual ratio on the version-management overview
  syncedAt              DateTime  @default(now())
  syncStatus            String    @default("ACTIVE") // "ACTIVE" | "NEW" | "REMOVED"
  reviewed              Boolean   @default(false) // set during the version-opening validation step
  needsAttention        Boolean   @default(false) // scope changed (NEW/REMOVED) after scopeApprovedAt was set
  isCore                Boolean   @default(false) // QA classification: core CR — independent axis from isStandAlone
  priorityTestDate      DateTime? // go-live date shown to QA when it's before this version / outside its scope — must be tested first, sorts first in its tester's queue
  notes                 String? // free-text QA note
  urgent                Boolean   @default(false) // flags for QA-lead follow-up on the home dashboard
  alreadyInProduction   Boolean   @default(false) // CR was already deployed separately (e.g. an earlier hotfix) — excluded from this version's required-plan/review checks without deleting the row
  qaArrivalDate         DateTime? // planned date the CR is expected to arrive at QA
  qaReceived            Boolean   @default(false) // QA lead confirms the CR actually arrived
  qaReceivedAt          DateTime? // actual arrival date — compared against qaArrivalDate to flag a late arrival
  isArchived            Boolean   @default(false) // RM archived this CR's QA work (see QaWorkPlanService.archiveCr) — hidden from active assignment views and excluded from tester load/capacity calcs, but the row and its QaAssignment/QaCycleTask history are kept, not deleted
  archivedAt            DateTime?
  archivedReason        String?

  version Version @relation(fields: [versionId], references: [id])
  team    Team    @relation(fields: [teamId], references: [id])

  @@unique([versionId, crNumber, teamId])
}

// ── Leaves / Seasons ─────────────────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

model Season {
  id        String   @id @default(uuid())
  name      String
  dateRange String
  isActive  Boolean  @default(false) // open for leave-request submissions right now — NOT "this is a real holiday"; unrelated to forcesOff
  forcesOff Boolean  @default(false) // true = mandatory non-working days (real holidays, e.g. imported via importHolidays) — default is nobody works, a LeaveRequest(kind='work') is the exception. false = optional leave-request window (e.g. summer vacation) — default is everyone works, a LeaveRequest(kind='leave') is the exception. Drives holiday exclusion in work-day scheduling (qa-workplan.service.ts's loadHolidayDays), independent of isActive.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dates    SeasonDate[]
  requests LeaveRequest[]
}

model SeasonDate {
  id         String   @id @default(uuid())
  seasonId   String
  date       DateTime
  label      String
  type       String // "holiday" | "chol_hamoed"
  orderIndex Int      @default(0)

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id       String      @id @default(uuid())
  userId   String
  seasonId String?
  date     DateTime
  kind     String // "leave" | "work"
  reason   String?
  status   LeaveStatus @default(PENDING)
  groupId  String? // shares one id across every day of a range submitted together — lets the UI display/approve the whole range as one unit while storage stays one-row-per-day (qa-workplan.service.ts's per-day lookup keeps working unchanged)

  decidedByName   String? // who approved/declined (denormalized name, no FK — same convention as QaWorkPlan.approvedBy)
  decidedAt       DateTime?
  cancelledByName String? // who cancelled — either the requesting employee or an approving manager
  cancelledAt     DateTime?
  cancelReason    String? // optional free-text reason for cancellation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id])

  @@index([groupId])
}

// ── QA Module ────────────────────────────────────────────────────────────────

enum SkillType {
  Professional
  Applications
  Tools
  Personal
  Business
}

model Skill {
  id        String    @id @default(uuid())
  name      String    @unique
  type      SkillType
  weight    Int       @default(3)
  createdAt DateTime  @default(now())

  testerSkills TesterSkill[]
}

model TesterProfile {
  userId    String   @id
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testerSkills TesterSkill[]
}

model TesterSkill {
  userId     String
  skillId    String
  level      Int       @default(1) // 1–5
  lastUsedAt DateTime? // set when the tester is assigned a CR requiring this skill — drives the QA engine's continuity score (not the same as updatedAt, which also bumps on a plain level edit)
  updatedAt  DateTime  @updatedAt

  tester TesterProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  skill  Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model QaAssignment {
  id                        String    @id @default(uuid())
  versionId                 String
  crNumber                  String
  crLabel                   String?
  application               String? // denormalized from VersionCrAssignment (for continuity queries)
  userId                    String
  qaEffort                  Float? // denormalized days (for load-balancing queries)
  autoScore                 Int? // computed score at assignment time (0-100)
  notes                     String?
  assignedBy                String?
  isStandAlone              Boolean? // null=inherit VCA; true=SA; false=force integrative
  cycles                    String[]  @default([]) // e.g. ["CYCLE_1","CYCLE_2","CYCLE_3","STAND_ALONE","UAT"]
  sortOrder                 Int? // tester queue position (1, 2, 3…)
  secondaryTesterId         String? // optional secondary reviewer userId
  secondarySkillLevel       Int?      @default(3)
  secondaryParticipationPct Int?      @default(50) // % of total effort the secondary tester carries (rest goes to primary) — editable, defaults to an even 50/50 split
  standAloneDueDate         DateTime? // optional early deadline for a Stand Alone CR — pulls it ahead of other SA work for this tester
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  version       Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  secondaryUser User?   @relation("qaSecondaryAssignments", fields: [secondaryTesterId], references: [id])

  @@unique([versionId, crNumber])
}

// ── QA Work Plan ─────────────────────────────────────────────────────────────

model QaWorkPlan {
  id               String    @id @default(uuid())
  versionId        String    @unique
  status           String    @default("DRAFT") // DRAFT | APPROVED
  cycle1Start      DateTime
  testingEnd       DateTime
  cycle1LengthDays Int? // fixed capacity parameter for cycle 1 (work days) — editable on screen, defaults to 12 when unset
  cycle2LengthDays Int? // fixed capacity parameter for cycle 2 (work days) — independently editable, defaults to round(cycle1LengthDays*0.5) when unset
  cycle3LengthDays Int? // fixed capacity parameter for cycle 3 (work days) — independently editable, defaults to round(cycle1LengthDays*0.3) when unset
  notes            String?
  createdBy        String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  version    Version               @relation(fields: [versionId], references: [id], onDelete: Cascade)
  cycles     QaCycle[]
  changeLogs QaWorkPlanChangeLog[]
}

// תיעוד תיקונים בתוכנית עבודה — נכתב רק כאשר התוכנית כבר במצב APPROVED, כדי
// לענות בדיוק על הצורך: "מה השתנה אחרי שהתוכנית אושרה". תיקונים לפני האישור
// (עוד בטיוטה) אינם נרשמים — צפויים ושכיחים מדי כדי להיות שימושיים כלוג.
model QaWorkPlanChangeLog {
  id            String   @id @default(uuid())
  workPlanId    String
  qaCycleTaskId String? // null כאשר המשימה עצמה נמחקה
  action        String // EFFORT_CHANGED | TASK_DELETED | TASK_ARCHIVED | TASK_RESTORED | TASK_REASSIGNED | TASK_TOGGLED
  crNumber      String?
  userEmail     String?
  beforeData    Json?
  afterData     Json? // for TASK_ARCHIVED/TASK_RESTORED: { reason }
  createdAt     DateTime @default(now())

  workPlan QaWorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
}

model QaCycle {
  id           String   @id @default(uuid())
  workPlanId   String
  cycleType    String // CYCLE_1 | CYCLE_2 | CYCLE_3 | STAND_ALONE | REHEARSAL | GO_LIVE
  plannedStart DateTime
  plannedEnd   DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workPlan QaWorkPlan    @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  tasks    QaCycleTask[]
}

model QaCycleTask {
  id           String   @id @default(uuid())
  cycleId      String
  crNumber     String
  crLabel      String?
  taskType     String   @default("CR") // CR | STAND_ALONE | REGRESSION
  userId       String
  effortDays   Float
  plannedStart DateTime
  plannedEnd   DateTime
  isActive     Boolean  @default(true)
  isPrimary    Boolean  @default(true)
  sortOrder    Int      @default(0)
  notes        String?
  isArchived   Boolean  @default(false) // soft-removed — excluded from active schedule/view but restorable; see QaWorkPlanChangeLog for the archive/restore reason trail
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cycle QaCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user  User    @relation(fields: [userId], references: [id])
}

model ActivityBoardEntry {
  id            String    @id @default(cuid())
  versionId     String
  activityKey   String
  label         String
  owner         String    @default("")
  ownerEmployee String    @default("")
  notes         String    @default("")
  attendees     String[]  @default([])
  category      String    @default("other")
  dateStart     DateTime?
  dateEnd       DateTime?
  sortOrder     Int       @default(0)
  isRelevant    Boolean   @default(true)
  isCustom      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([versionId, activityKey])
}

model RunbookEntry {
  id              String    @id @default(cuid())
  versionId       String
  runbookId       String
  stepIndex       Int
  employee        String    @default("")
  employeeUserId  String? // resolved userId of `employee`, when it matches a real team member — used for targeted notifications
  startTime       String    @default("") // "HH:MM"
  endTime         String    @default("") // "HH:MM"
  runDate         DateTime? // calendar date this step is scheduled for (startTime/endTime have no date of their own)
  team            String    @default("")
  status          String    @default("pending")
  notified15MinAt DateTime? // set once the "starts in ~15 min" notification has fired — prevents duplicate sends
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([versionId, runbookId, stepIndex])
}

// Editable override of a built-in RUNBOOKS[templateKey] step list (frontend
// constant). steps[].key is a stable id — NOT the array position — so
// RunbookEntry.stepIndex (keyed by step key) survives step add/delete/reorder
// without silently misaligning to the wrong activity. nextStepKey is a
// monotonic counter so a deleted step's key is never reissued to a new step.
model RunbookTemplate {
  id          String   @id @default(uuid())
  templateKey String   @unique
  title       String
  envLabel    String
  steps       Json
  nextStepKey Int      @default(100)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Release Intelligence Center (Phase 1: schema + Overview) ──────────────
// Non-intrusive extension layer over existing Deployment/QA data — see
// project memory "Release Intelligence Center spec" for the full spec.
// ReleaseHealth/ReleaseForecast are single-row-per-version snapshots
// (recomputed and upserted whenever the Overview screen is loaded), not
// historical logs.

model ReleaseRisk {
  id          String     @id @default(uuid())
  versionId   String
  title       String
  description String?
  severity    Priority   @default(MEDIUM)
  impact      String?
  probability String?
  owner       String?
  mitigation  String?
  status      RiskStatus @default(OPEN)
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])
}

// Manual, RM/ADMIN-authored notices pinned atop the Home risks/activities
// feed — supersedes the old single Version.homeNotice text field, allowing
// several concurrent notices each with their own urgency level.
model VersionNotice {
  id        String   @id @default(uuid())
  versionId String
  text      String
  urgency   Priority @default(MEDIUM)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])
}

model ReleaseInsight {
  id             String   @id @default(uuid())
  versionId      String
  category       String // AUTO: COVERAGE|FORECAST|CAPACITY|CR_HEALTH|REOPEN — MANUAL: ANNOUNCEMENT|ENVIRONMENT|KNOWN_ISSUE|RELEASE|BLOCKER
  severity       Priority @default(MEDIUM)
  title          String? // manual messages only — auto-insights use `message` alone
  message        String
  recommendation String?
  source         String   @default("AUTO") // AUTO | MANUAL
  createdBy      String? // manual messages only
  createdAt      DateTime @default(now())

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model ReleaseHealth {
  versionId     String   @id
  healthScore   Int
  coverageScore Int
  qualityScore  Int
  riskScore     Int
  forecastScore Int
  calculatedAt  DateTime @default(now())

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model ReleaseForecast {
  versionId      String    @id
  calculatedDate DateTime  @default(now())
  remainingTests Int
  velocity       Float
  forecastDate   DateTime?
  status         String // ON_TRACK | AT_RISK | BEHIND_PLAN

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

// Advisory/record-only decision log — spec section 26. Deliberately NOT
// coupled to VersionStatus or any existing workflow gate (non-intrusive
// extension rule, spec section 2); approving a stage here has zero effect
// anywhere else in the app.
model GoNoGoDecision {
  versionId            String    @id
  systemRecommendation String // GO | CONDITIONAL_GO | NO_GO
  qaManagerStatus      String? // PENDING | APPROVED | REJECTED
  qaManagerBy          String?
  qaManagerAt          DateTime?
  releaseManagerStatus String?
  releaseManagerBy     String?
  releaseManagerAt     DateTime?
  managementStatus     String?
  managementBy         String?
  managementAt         DateTime?
  updatedAt            DateTime  @updatedAt

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

// ── Release Quality Hub ──────────────────────────────────────────────────────
// Consumes an organizational quality-scoring methodology that is computed
// OUTSIDE DeployCenter (Excel exports from the QC system). DeployCenter never
// recomputes KPIs/formulas/weights here — these two models just store the
// already-computed values so they can be visualized/compared/navigated.
// Soft-linked to Version by name string (not FK): most historical releases
// (124 of them, back to 2017) predate DeployCenter and have no Version row.

model KpiDefinition {
  id                String   @id @default(uuid())
  kpiOrder          Int
  kpiName           String   @unique // join key: matches ReleaseKpiScore.kpiName exactly
  kpiType           String // "%" | "Quantity" | "Time"
  target            Float
  weight            Float
  measuredEntity    String // איפיון / פיתוח / QA / צוות הטמעה / ALL
  purpose           String?
  description       String?
  dataSource        String?
  measurementPeriod String?
  trend             String? // "מינימום" today — lower Grade vs Target is better
  comments          String?
  updatedAt         DateTime @updatedAt
}

model ReleaseKpiScore {
  id              String   @id @default(uuid())
  releaseName     String // REL_NAME, e.g. "ITv04-2026" — soft-link to Version.name
  kpiName         String // SegmentName — soft-link to KpiDefinition.kpiName
  target          Float
  grade           Float? // null when source had "-"
  weight          Float
  relativeScore   Float?
  calcScore       Float?
  allCount        Float? // "ALL" column from source — meaning not fully confirmed, displayed as-is
  showStopper     Float? // "TB, SS"
  severe          Float? // "sev"
  medium          Float? // "Med"
  low             Float? // "Low"
  importedAt      DateTime @default(now())
  qualitativeNote String? // manually-entered per-release analysis: אחריות / שיפורים נדרשים / מאפייני הבעיות

  @@unique([releaseName, kpiName])
  @@index([releaseName])
  @@index([kpiName])
}

// Structured, multi-row replacement for ReleaseKpiScore.qualitativeNote (kept
// as a legacy column, no longer written/read from the UI). Split into two
// models 2026-08-29 (was one combined KpiImprovementItem): a problem
// observation is a point-in-time fact about one release+KPI, while an
// improvement task is longer-lived and tracked across releases via status —
// bundling them forced every status update to also carry a (soon stale)
// problem description, and repeated the same description across tasks
// derived from one root cause. No FK between them — both just tag the same
// releaseName+kpiName, kept deliberately simple.
model KpiProblemNote {
  id                     String   @id @default(uuid())
  releaseName            String
  kpiName                String
  problemCharacteristics String? // מאפייני הבעיות
  defectCount            Int? // סה"כ תקלות
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([releaseName, kpiName])
}

// Feeds the cross-release "Improvement Tracking" screen, which lists every
// task from every KPI/release together (spec confirmed 2026-08-29).
model KpiImprovementTask {
  id                  String   @id @default(uuid())
  releaseName         String
  kpiName             String
  requiredImprovement String? // שיפורים נדרשים
  mainDevelopments    String? // פיתוחים עיקריים
  responsibility      String? // אחריות
  status              String   @default("OPEN") // OPEN | IN_PROGRESS | DONE
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([releaseName, kpiName])
  @@index([status])
}

// ── Incidents / RCA Wizard ───────────────────────────────────────────────────
// Root-cause-analysis workflow for Go-Live incidents. "Go-Live" here IS a
// Version (ACTIVE/MORNING_AFTER/COMPLETED) — this module doesn't introduce a
// separate GoLive concept. "QC incidents" are sourced from the existing
// Oracle/QC defect integration (qc.service.ts's getDefects/getBugDashboard),
// not a new external incident system — importing pulls real defect rows for
// the version and creates one Incident row per selected defect.

enum IncidentStatus {
  NEW // imported, RCA not started
  ANALYZING // RCA in progress (5-Why/Fishbone/AI)
  RCA_DONE // RCA submitted, action items may still be open
  CLOSED // approved and closed (RELEASE_MANAGER)
}

enum RcaMethod {
  FIVE_WHY
  FISHBONE
  AI
  GUIDED // structured facts-first decision-tree investigation — see guided-investigation-tree.ts. Product spec from the user 2026-08-09: stop users jumping straight to "root cause" before facts are actually collected.
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  OVERDUE
}

// Corrective (fixes this occurrence) vs Preventive (stops recurrence) — only
// set on the two ActionItems the GUIDED method auto-creates from its decision
// tree's leaf; null for actions added the ordinary way (manual/AI/Fishbone),
// which don't carry this classification.
enum ActionItemKind {
  CORRECTIVE
  PREVENTIVE
}

// Root Cause Status — tracks whether the root cause's own remediation was
// ever actually carried through, separate from Incident.status (which just
// tracks the incident's workflow up to CLOSED) and ActionStatus (which
// tracks individual action items). Values from the user 2026-08-09.
enum RcaStatus {
  OPEN
  INVESTIGATION
  COMPLETED
  CANCELLED
}

model IncidentGroup {
  id        String   @id @default(uuid())
  versionId String
  reason    String // why these incidents were clustered together (AI-suggested or manual)
  createdAt DateTime @default(now())

  incidents Incident[]
}

model Incident {
  id              String         @id @default(uuid())
  versionId       String
  qcDefectId      String // source BUG_ID from Oracle/QC — see TargetDefectDto.id
  title           String
  description     String?
  expectedVersion String?
  actualVersion   String?
  severity        Priority?
  status          IncidentStatus @default(NEW)
  assignedToName  String? // denormalized — same convention as CrPlan.crManagerApprovedBy
  groupId         String?

  // ── Real QC fields, pulled at import time (BG_USER_58/16/14/55/47/44/46)
  // — see GO_LIVE_INCIDENTS_SQL. crReferenceNumber is what lets evidence
  // collection correlate this incident to the actual CrPlan/Task rows for
  // the same CR+version, not just the bare defect record.
  defectType          String? // BG_USER_06 — from DefectDto, not previously stored on Incident
  crReferenceNumber   String?
  mainModule          String? // BG_USER_16 — suspected component
  subModule           String? // BG_USER_14
  systemComponent     String? // BG_USER_55
  impact              String? // BG_USER_47 — business impact, free text from QC
  businessProcess     String? // BG_USER_44
  mainBusinessProcess String? // BG_USER_46

  // ── Manual triage fields — NOT available anywhere in QC's real schema
  // (verified against a live AllBugs export 2026-08-08: no affected-user
  // count, no customer-facing flag, no downtime-duration field exists there
  // at all). Filled by hand during the investigation instead of invented —
  // per explicit product decision, these are part of the "evidence dossier"
  // a human fills in, not sourced from any system.
  affectedUsersCount Int?
  customerFacing     Boolean?
  downtimeMinutes    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  version      Version               @relation(fields: [versionId], references: [id], onDelete: Cascade)
  group        IncidentGroup?        @relation(fields: [groupId], references: [id])
  evidence     IncidentEvidence[]
  rca          Rca?
  actions      ActionItem[]
  chatMessages IncidentChatMessage[]

  @@unique([versionId, qcDefectId])
  @@index([versionId])
}

// The AI-driven conversational RCA flow — replaces manually filling separate
// Evidence/RCA-method tabs: the whole incident walkthrough (evidence review,
// root-cause questioning, lessons, proposed actions) happens as one chat.
// concluded=true once the AI has emitted its structured RCA conclusion (which
// is what actually populates Rca/RcaAnswer/ActionItem — see
// incidents.service.ts's replyChat) — the frontend uses this to know when to
// stop showing a reply box and start showing the review/close panel.
model IncidentChatMessage {
  id         String   @id @default(uuid())
  incidentId String
  role       String // 'AI' | 'USER'
  content    String
  concluded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// Auto-collected (docker image, migration status, health-check snapshot,
// linked defect log) or manually-attached evidence. `content` is a short
// human-readable summary; `meta` carries the full structured payload for the
// AI-analyze prompt without bloating the list view.
model IncidentEvidence {
  id         String   @id @default(uuid())
  incidentId String
  type       String // 'DOCKER_IMAGE' | 'DB_MIGRATION_STATUS' | 'HEALTH_CHECK' | 'QC_DEFECT_LOG' | 'MANUAL'
  content    String
  meta       Json?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model Rca {
  id              String    @id @default(uuid())
  incidentId      String    @unique
  method          RcaMethod
  category        String? // Root Cause Category — fixed taxonomy (see incidents/root-cause-taxonomy.ts). NOT Fishbone's People/Process/Technology/Environment buckets — those stay per-cause in RcaAnswer.question.
  rootCauseReason String? // Root Cause (RCA) — specific reason from the taxonomy, scoped under `category`
  rootCause       String? // short root-cause summary (free text)
  description     String? // RCA Description — detailed narrative: context/conditions that led to the fault, distinct from the short `rootCause` summary
  directCause     String? // GUIDED method only — the immediate/direct cause found at the decision-tree leaf, distinct from `rootCause` (the underlying process gap). Stages 5-6 of guided-investigation-tree.ts.
  status          RcaStatus @default(OPEN) // Root Cause Status — tracks lesson-implementation follow-through, updated independently of Incident.status
  aiConfidence    Float? // 0..1, AI method only
  aiRawResponse   Json? // full AI response, kept for audit/debugging
  createdByName   String
  approvedBy      String? // RELEASE_MANAGER who closed the incident
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── GUIDED method only (facts-first structured investigation) ──
  // Stage 2 — facts-only collection, deliberately separate free-text fields
  // (not RcaAnswer rows) so the UI can render/require them as a fixed form
  // and gate stage 3 behind them ("don't let the user jump to root cause").
  factsActionTaken      String? // מה הפעולה שבוצעה
  factsExpectedResult   String? // מה היה אמור לקרות
  factsActualResult     String? // מה קרה בפועל
  factsTiming           String? // מתי התחילה: AFTER_RELEASE | AFTER_INFRA_CHANGE | AFTER_CONFIG_CHANGE | UNKNOWN
  factsReproducibility  String? // האם משתחזרת: ALWAYS | PARTIAL | RANDOM
  factsLocked           Boolean @default(false) // set once all facts above are filled — gates the tree-investigation stage in the UI
  // Stage 3 — the path actually walked through guided-investigation-tree.ts:
  // [{ nodeId, question, answerValue, answerLabel }, ...]. Stage 5's 5-Why is
  // deterministically derived from this same path (see buildAutoFiveWhy) and
  // stored as ordinary RcaAnswer rows, not duplicated here.
  treePath   Json?
  treeLeafId String? // which leaf the path terminated at — drives stage 4's inferred category/reason and stage 6's corrective/preventive action templates

  incident Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  answers  RcaAnswer[]
  lessons  RcaLesson[]
}

// One row per team's lesson — replaces the previous 5 fixed lessonsReq/Spec/
// Dev/Qa/Ops columns. Which teams are even relevant is now dynamic (see
// incidents.service.ts's getRelevantTeams: real teams from the CrPlan rows
// for the incident's linked CR, or the full active Team list as a fallback
// when no CR is linked) — a fixed 5-column shape can't represent that.
// teamId is nullable/soft — the team could be deleted later, or the lesson
// could predate any CR link; teamName is always kept so the lesson stays
// readable either way (same denormalized-name convention as
// CrPlan.crManagerApprovedBy elsewhere in this schema).
model RcaLesson {
  id       String  @id @default(uuid())
  rcaId    String
  teamId   String?
  teamName String
  text     String

  rca Rca @relation(fields: [rcaId], references: [id], onDelete: Cascade)

  @@index([rcaId])
}

// One row per 5-Why/Fishbone question-answer round.
// Doubles as the 5-Why question/answer round AND the Fishbone cause list —
// for Fishbone, `question` holds the category name (People/Process/
// Technology/Environment) and `answer` holds the candidate cause text;
// `isRootCause` marks which one the user identified as the actual root
// (5-Why rows never set it). Reused rather than a dedicated Fishbone model
// since both are just "step → labeled text", and only the label's meaning
// differs.
model RcaAnswer {
  id          String   @id @default(uuid())
  rcaId       String
  step        Int
  question    String
  answer      String
  isRootCause Boolean  @default(false)
  evidenceIds String[] @default([])
  createdAt   DateTime @default(now())

  rca Rca @relation(fields: [rcaId], references: [id], onDelete: Cascade)
}

model ActionItem {
  id         String       @id @default(uuid())
  incidentId String
  title      String
  // Denormalized team name — was a fixed 5-value enum (Requirements/Spec/
  // Dev/QA/Ops), replaced with a real team name (see getRelevantTeams) so an
  // action can be assigned to the actual team that worked the CR, not a
  // generic SDLC-stage bucket. Same denormalized-string convention as
  // CrPlan.crManagerApprovedBy — no FK, since the team list a given action
  // was chosen from is dynamic per-incident, not a fixed enum.
  team       String
  ownerName  String?
  dueAt      DateTime?
  notes      String?
  priority   Priority        @default(MEDIUM)
  status     ActionStatus    @default(OPEN)
  kind       ActionItemKind? // set only for the two actions the GUIDED method auto-creates (corrective/preventive) — null for actions added the ordinary way
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}
