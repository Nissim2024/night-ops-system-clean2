# ============================================================
# DeployCenter — Environment Variables (Production)
# מלא את כל הערכים לפני הרצת install.sh
# ============================================================

NODE_ENV=prod
PORT=3000

# ── Database ──────────────────────────────────────────────
# החלף: USER, PASSWORD, DB_NAME
DATABASE_URL="postgresql://dc_user:CHANGE_PASSWORD_HERE@localhost:5432/deploycenter_prod"

# ── Security ──────────────────────────────────────────────
# מחרוזת ארוכה ואקראית (לפחות 32 תווים) — אל תשתמש בדוגמה!
JWT_SECRET=CHANGE_TO_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ── URLs ──────────────────────────────────────────────────
# הכתובת שדרכה המשתמשים ניגשים למערכת
CORS_ORIGIN=https://deploycenter.yourcompany.com

# ── Email (אופציונלי) ─────────────────────────────────────
EMAIL_HOST=smtp.yourcompany.com
EMAIL_PORT=587
EMAIL_USER=deploycenter@yourcompany.com
EMAIL_PASS=CHANGE_EMAIL_PASSWORD
EMAIL_FROM=deploycenter@yourcompany.com
